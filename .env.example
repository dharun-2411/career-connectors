# =================================================================
# Career Connectors - Environment Variables Template
# =================================================================

# -----------------------------------------------------------------
# Database Configuration (PostgreSQL)
# -----------------------------------------------------------------
SPRING_PROFILES_ACTIVE=dev
DB_HOST=localhost
DB_PORT=5432
DB_NAME=career_connectors
DB_USERNAME=postgres
DB_PASSWORD=postgrespassword
DB_URL=jdbc:postgresql://localhost:5432/career_connectors

# Optional DB Flags
FLYWAY_ENABLED=true
HIBERNATE_DDL_AUTO=update
SHOW_SQL=false

# -----------------------------------------------------------------
# Backend Server & Security Configuration
# -----------------------------------------------------------------
SERVER_PORT=8080
APP_JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
APP_JWT_EXPIRATION_MS=86400000
APP_JWT_REFRESH_EXPIRATION_MS=604800000
APP_AI_SERVICE_BASE_URL=http://localhost:8000
APP_AI_SERVICE_TIMEOUT_MS=4000

# -----------------------------------------------------------------
# AI Microservice Configuration (FastAPI)
# -----------------------------------------------------------------
HOST=0.0.0.0
PORT=8000

# -----------------------------------------------------------------
# Frontend Configuration (React + Vite)
# -----------------------------------------------------------------
VITE_API_BASE_URL=/api/v1
